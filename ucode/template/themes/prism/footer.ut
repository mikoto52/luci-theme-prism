</div><!-- #maincontent -->

{% if (!blank_page): %}
<footer id="footer">
	<span class="pulse"></span>
	<span>Powered by {{ version.luciname }} ({{ version.luciversion }})</span>
	<span class="sep">/</span>
	<span>{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</span>
	{% if (lua_active): %}<span class="sep">/</span><span>{{ _('Lua compatibility mode active') }}</span>{% endif %}
	<span class="theme-name">Prism</span>
</footer>
</div><!-- #shell -->
<script>L.require('menu-prism')</script>
{% endif %}
</body>
</html>

{#
 Prism — login screen
 Licensed under the Apache License, Version 2.0
-#}
{%
	const boardinfo = ubus.call('system', 'board') ?? {};
	const hostname = striptags(boardinfo.hostname ?? 'OpenWrt');
	const model = striptags(boardinfo.model ?? '');

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#07060f">
<title>{{ hostname }} · {{ _('Log in') }}</title>
<link rel="stylesheet" href="{{ media }}/cascade.css">
<link rel="stylesheet" href="{{ media }}/login.css">
<link rel="icon" href="{{ media }}/favicon.svg" type="image/svg+xml">
</head>
<body class="login-page">

<div class="prism-bg" aria-hidden="true">
	<span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span>
	<span class="grid"></span><span class="noise"></span>
</div>

<main class="login-wrap">
	<form method="post" class="login-card">
		<div class="login-mark" aria-hidden="true">
			<svg viewBox="0 0 48 48">
				<defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" stop-color="#22d3ee"/><stop offset=".5" stop-color="#a855f7"/><stop offset="1" stop-color="#f472b6"/>
				</linearGradient></defs>
				<path d="M24 4 44 40H4Z" fill="none" stroke="url(#lg)" stroke-width="2.6" stroke-linejoin="round"/>
				<path d="M24 4 30 40M24 4 14 40" stroke="url(#lg)" stroke-width="1.3" opacity=".6"/>
			</svg>
		</div>

		<h1>{{ hostname }}</h1>
		<p class="login-sub">{{ model ? model : _('Authorization Required') }}</p>

		{% if (fuser): %}
		<div class="alert-message error">{{ _('Invalid username and/or password! Please try again.') }}</div>
		{% endif %}

		<label class="field">
			<input type="text" name="luci_username" value="{{ entityencode(duser ?? 'root', true) }}" placeholder=" " autocomplete="username" autocapitalize="off" spellcheck="false">
			<span>{{ _('Username') }}</span>
		</label>

		<label class="field">
			<input type="password" name="luci_password" placeholder=" " autocomplete="current-password">
			<span>{{ _('Password') }}</span>
		</label>

		<button type="submit" class="cbi-button cbi-button-apply login-submit">{{ _('Log in') }}</button>

		<p class="login-foot">{{ version.distname }} {{ version.distversion }} · {{ version.luciname }}</p>
	</form>
</main>

<script>
	const input = document.getElementsByName('luci_password')[0];
	if (input) input.focus();
	document.querySelector('.login-card').addEventListener('submit', (ev) => ev.currentTarget.classList.add('busy'));
</script>
</body>
</html>
